generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// FASE 1: NÚCLEO ORGANIZACIONAL E RBAC
// ---------------------------------------------------------

model Company {
  id             String   @id @default(cuid())
  corporate_name String
  trade_name     String
  cnpj           String?  @unique
  email          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  locations        Location[]
  departments      Department[]
  users            User[]
  Asset            Asset[]
  Ticket           Ticket[]
  Problem          Problem[]
  Change           Change[]
  Supplier         Supplier[]
  Contract         Contract[]
  Project          Project[]
  KnowledgeArticle KnowledgeArticle[]

  @@map("companies")
}

model Location {
  id         String   @id @default(cuid())
  name       String
  address    String?
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  departments Department[]
  users       User[]
  Asset       Asset[]

  @@map("locations")
}

model Department {
  id          String  @id @default(cuid())
  name        String
  company_id  String
  location_id String?

  company  Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [location_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users   User[]
  Asset   Asset[]
  Ticket  Ticket[]
  Problem Problem[]

  @@map("departments")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String // JSON string of permissions
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id            String  @id @default(cuid())
  name          String
  username      String? @unique
  email         String  @unique
  password_hash String
  job_title     String?
  phone         String?
  avatar        String?
  status        String  @default("ACTIVE") // ACTIVE, INACTIVE, EXTERNAL

  role_id       String
  department_id String?
  location_id   String?
  company_id    String
  manager_id    String?

  role       Role        @relation(fields: [role_id], references: [id])
  department Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [location_id], references: [id], onDelete: SetNull)
  company    Company     @relation(fields: [company_id], references: [id], onDelete: Restrict)

  manager      User?  @relation("ManagerToUser", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates User[] @relation("ManagerToUser")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Asset             Asset[]
  tickets_requested Ticket[]        @relation("RequesterTickets")
  tickets_assigned  Ticket[]        @relation("AssignedTickets")
  ticket_comments   TicketComment[]

  problems_assigned Problem[]  @relation("AssignedProblems")
  changes_requested Change[]   @relation("RequestedChanges")
  changes_managed   Change[]   @relation("ManagedChanges")
  contracts_managed Contract[] @relation("ContractManager")

  projects_managed Project[]          @relation("ProjectManager")
  projects_member  Project[]          @relation("ProjectMembers")
  project_tasks    ProjectTask[]      @relation("TaskAssignee")
  articles_written KnowledgeArticle[] @relation("ArticleAuthor")
  bookings         Booking[]          @relation("UserBookings")

  channels               ChatChannel[]          @relation("ChannelMembers")
  sent_messages          ChatMessage[]          @relation("SentMessages")
  chat_reactions         ChatMessageReaction[]
  chat_receipts          ChatMessageReceipt[]
  chat_settings          ChatUserSettings?
  saved_stickers         UserSticker[]
  password_reset_requests PasswordResetRequest[]
  last_seen_at           DateTime?

  @@map("users")
}

// ---------------------------------------------------------
// FASE 2: CMDB E INVENTÁRIO DE TI
// ---------------------------------------------------------

model Asset {
  id             String    @id @default(cuid())
  internal_id    String    @unique // Código interno único ex: AST-0001
  asset_tag      String?   @unique // Código patrimonial
  type           String // COMPUTER, MONITOR, PRINTER, NETWORK, OTHER
  name           String
  status         String    @default("IN_USE") // IN_USE, IN_STOCK, MAINTENANCE, RETIRED, LOST
  manufacturer   String?
  model          String?
  serial_number  String?
  purchase_date  DateTime?
  warranty_end   DateTime?
  purchase_value Float?
  notes          String?

  // Relacionamentos Organizacionais
  user_id       String?
  department_id String?
  location_id   String?
  company_id    String

  user       User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [location_id], references: [id], onDelete: SetNull)
  company    Company     @relation(fields: [company_id], references: [id], onDelete: Restrict)

  // Especializações (Relações 1:1)
  computer       Computer?
  network_device NetworkDevice?
  printer        Printer?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  Ticket     Ticket[]
  Problem    Problem?  @relation(fields: [problemId], references: [id])
  problemId  String?
  Change     Change?   @relation(fields: [changeId], references: [id])
  changeId   String?
  Supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?
  Contract   Contract? @relation(fields: [contractId], references: [id])
  contractId String?
  Project    Project?     @relation(fields: [projectId], references: [id])
  projectId  String?
  Booking    Booking[]
  ticket_items TicketItem[]

  @@index([status])
  @@index([type])
  @@index([created_at])
  @@map("assets")
}

model Computer {
  id                 String  @id @default(cuid())
  asset_id           String  @unique
  hostname           String?
  processor          String?
  memory_mb          Int?
  storage_gb         Int?
  mac_address        String?
  ip_address         String?
  os_name            String?
  os_version         String?
  device_type        String? @default("DESKTOP") // DESKTOP, NOTEBOOK, MINI_PC, ALL_IN_ONE, SERVER, OUTRO
  domain_workgroup   String? @default("WORKGROUP")
  physical_location  String?
  responsible_it_id  String?
  primary_user_id    String?

  asset          Asset               @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  assignments    PcUserAssignment[]
  accounts       PcAccount[]
  email_accounts PcEmailAccount[]

  @@index([hostname])
  @@index([ip_address])
  @@map("computers")
}

model NetworkDevice {
  id          String  @id @default(cuid())
  asset_id    String  @unique
  ip_address  String?
  mac_address String?
  firmware    String?
  port_count  Int?

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@map("network_devices")
}

model Printer {
  id          String  @id @default(cuid())
  asset_id    String  @unique
  ip_address  String?
  mac_address String?
  is_network  Boolean @default(true)
  page_count  Int     @default(0)

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@map("printers")
}

model Software {
  id           String  @id @default(cuid())
  name         String
  manufacturer String?
  category     String?
  version      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  licenses License[]

  @@map("software")
}

model License {
  id              String    @id @default(cuid())
  software_id     String
  license_key     String?
  type            String // VOLUME, SUBSCRIPTION, PERPETUAL, OEM
  quantity        Int       @default(1)
  used_quantity   Int       @default(0)
  expiration_date DateTime?

  software Software @relation(fields: [software_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  Supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?
  Contract   Contract? @relation(fields: [contractId], references: [id])
  contractId String?

  @@map("licenses")
}

// ---------------------------------------------------------
// FASE 3: SERVICE DESK E CHAMADOS
// ---------------------------------------------------------

model TicketCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  parent_id   String?

  parent   TicketCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children TicketCategory[] @relation("CategoryHierarchy")

  tickets Ticket[]

  @@map("ticket_categories")
}

model Ticket {
  id          String @id @default(cuid())
  code        String @unique // ex: CH-00001245
  type        String // INCIDENT, REQUEST
  title       String
  description String

  status   String @default("NEW") // NEW, TRIAGE, ASSIGNED, IN_PROGRESS, WAITING_USER, WAITING_VENDOR, RESOLVED, CLOSED, CANCELED
  urgency  String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  impact   String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  priority String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  // Relacionamentos
  requester_id     String
  requester_name   String?
  assigned_to_id   String?
  assigned_to_name String?
  group_id         String? // Departamento ou Grupo Técnico
  category_id    String?
  asset_id       String?
  company_id     String

  requester   User            @relation("RequesterTickets", fields: [requester_id], references: [id])
  assigned_to User?           @relation("AssignedTickets", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  department  Department?     @relation(fields: [group_id], references: [id], onDelete: SetNull)
  category    TicketCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  asset       Asset?          @relation(fields: [asset_id], references: [id], onDelete: SetNull)
  company     Company         @relation(fields: [company_id], references: [id], onDelete: Restrict)

  // Timeline
  comments TicketComment[]
  items    TicketItem[]

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  resolved_at DateTime?
  closed_at   DateTime?
  Problem     Problem?  @relation(fields: [problemId], references: [id])
  problemId   String?
  Change      Change?   @relation(fields: [changeId], references: [id])
  changeId    String?

  @@index([status])
  @@index([created_at])
  @@index([category_id])
  @@index([group_id])
  @@index([assigned_to_id])
  @@index([requester_id])
  @@map("tickets")
}

model TicketItem {
  id          String   @id @default(cuid())
  ticket_id   String
  description String
  quantity    Int      @default(1)
  category    String?
  asset_id    String?
  unit        String?  @default("UN")
  notes       String?
  status      String?  @default("PENDING")

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  asset  Asset? @relation(fields: [asset_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("ticket_items")
}

model TicketComment {
  id          String  @id @default(cuid())
  ticket_id   String
  author_id   String
  content     String
  is_internal Boolean @default(false)

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  author User   @relation(fields: [author_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("ticket_comments")
}

// ---------------------------------------------------------
// FASE 4: PROBLEMAS E MUDANÇAS (ITIL)
// ---------------------------------------------------------

model Problem {
  id          String @id @default(cuid())
  code        String @unique // ex: PB-0000001
  title       String
  description String

  root_cause String?
  workaround String?
  solution   String?

  status   String @default("OPEN") // OPEN, INVESTIGATING, IDENTIFIED, RESOLVED, CLOSED
  priority String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  // Relacionamentos
  assigned_to_id String?
  group_id       String?
  company_id     String

  assigned_to User?       @relation("AssignedProblems", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [group_id], references: [id], onDelete: SetNull)
  company     Company     @relation(fields: [company_id], references: [id], onDelete: Restrict)

  // Vínculos
  tickets Ticket[]
  changes Change[]
  assets  Asset[]

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  resolved_at DateTime?

  @@map("problems")
}

model Change {
  id          String @id @default(cuid())
  code        String @unique // ex: MD-0000001
  title       String
  reason      String
  description String

  risk   String @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  impact String @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status String @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SCHEDULED, IMPLEMENTING, SUCCESS, FAILED, ROLLED_BACK

  execution_plan String?
  rollback_plan  String?
  test_plan      String?

  scheduled_start DateTime?
  scheduled_end   DateTime?

  // Relacionamentos
  requester_id String
  manager_id   String?
  company_id   String

  requester User    @relation("RequestedChanges", fields: [requester_id], references: [id])
  manager   User?   @relation("ManagedChanges", fields: [manager_id], references: [id], onDelete: SetNull)
  company   Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  // Vínculos
  problems Problem[]
  tickets  Ticket[]
  assets   Asset[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  Project    Project? @relation(fields: [projectId], references: [id])
  projectId  String?

  @@map("changes")
}

// ---------------------------------------------------------
// FASE 5: FORNECEDORES, CONTRATOS E CUSTOS
// ---------------------------------------------------------

model Supplier {
  id           String  @id @default(cuid())
  name         String
  trade_name   String?
  cnpj         String? @unique
  contact_name String?
  email        String?
  phone        String?
  website      String?
  address      String?
  status       String  @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED

  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  contracts Contract[]
  assets    Asset[]
  licenses  License[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("suppliers")
}

model Contract {
  id          String  @id @default(cuid())
  code        String  @unique // ex: CT-2026-001
  title       String
  type        String // SUPPORT, LICENSING, LEASING, INTERNET, OTHER
  description String?

  start_date          DateTime
  end_date            DateTime
  renewal_notice_days Int      @default(30)

  total_value Float?
  currency    String @default("BRL")
  status      String @default("ACTIVE") // DRAFT, ACTIVE, EXPIRED, CANCELED

  supplier_id String
  company_id  String
  manager_id  String?

  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  company  Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  manager  User?    @relation("ContractManager", fields: [manager_id], references: [id], onDelete: SetNull)

  // Vínculos
  assets   Asset[]
  licenses License[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("contracts")
}

// ---------------------------------------------------------
// FASE 6: PROJETOS, CONHECIMENTO E RESERVAS
// ---------------------------------------------------------

model Project {
  id          String  @id @default(cuid())
  code        String  @unique // ex: PRJ-2026-001
  name        String
  description String?
  status      String  @default("PLANNING") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, CANCELED
  priority    String  @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  start_date DateTime?
  end_date   DateTime?

  manager_id String
  company_id String

  manager User    @relation("ProjectManager", fields: [manager_id], references: [id])
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  // Equipe
  members User[] @relation("ProjectMembers")

  // Tarefas
  tasks ProjectTask[]

  // Vínculos
  assets  Asset[]
  changes Change[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("projects")
}

model ProjectTask {
  id          String  @id @default(cuid())
  project_id  String
  title       String
  description String?
  status      String  @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String  @default("MEDIUM")

  start_date DateTime?
  due_date   DateTime?

  assigned_to_id String?

  project     Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assigned_to User?   @relation("TaskAssignee", fields: [assigned_to_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("project_tasks")
}

model KnowledgeArticle {
  id        String  @id @default(cuid())
  title     String
  content   String // Markdown ou HTML
  category  String // FAQ, TUTORIAL, POLICY, TROUBLESHOOTING, MANUAL
  status    String  @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  is_public Boolean @default(false)

  author_id  String
  company_id String

  author  User    @relation("ArticleAuthor", fields: [author_id], references: [id])
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  view_count Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  manuals SystemManual[]

  @@map("knowledge_articles")
}

// ---------------------------------------------------------
// FASE 6B: MANUAIS OFICIAIS E AJUDA CONTEXTUAL INTELIGENTE
// ---------------------------------------------------------

model SystemManual {
  id               String   @id @default(cuid())
  module           String   // ex: service-desk, connect, cmdb, pc-access, etc.
  submodule        String?  // ex: tickets, new, stickers, vault, etc.
  context_key      String   // Chave estável de contexto: ex: "service-desk", "service-desk/new", "connect/stickers"
  route_pattern    String   // Padrão de rota: ex: "/service-desk", "/service-desk/new", "/connect"
  
  title            String   // ex: "Manual — Como Abrir um Chamado"
  description      String?  // Breve resumo das instruções do manual
  version          String   @default("1.0") // ex: "1.0", "1.1", "2.0"
  status           String   @default("PUBLISHED") // DRAFT, IN_REVIEW, APPROVED, PUBLISHED, ARCHIVED
  
  pdf_url          String?  // URL do arquivo PDF (ou rota de download/stream /api/manuals/[id]/pdf)
  file_name        String?  // ex: "Manual_Como_Abrir_Chamado_v1.0.pdf"
  file_size        Int?     // Tamanho em bytes
  
  content_markdown String?  @db.Text // Conteúdo canônico estruturado e pesquisável
  tags             String?  // Tags separadas por vírgula para busca inteligente
  order_index      Int      @default(0)
  
  article_id       String?
  article          KnowledgeArticle? @relation(fields: [article_id], references: [id], onDelete: SetNull)
  
  created_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([context_key, status])
  @@index([module])
  @@map("system_manuals")
}

model Booking {
  id       String @id @default(cuid())
  asset_id String
  user_id  String

  start_time DateTime
  end_time   DateTime

  purpose String?
  status  String  @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE, COMPLETED, CANCELED

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  user  User  @relation("UserBookings", fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("bookings")
}

// ---------------------------------------------------------
// FASE 7: SINGETI CONNECT (CHAT CORPORATIVO)
// ---------------------------------------------------------

model ChatChannel {
  id          String   @id @default(cuid())
  name        String?  // Nulo se for chat direto entre 2 pessoas
  description String?
  image       String?
  is_group    Boolean  @default(false)
  admin_id    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members  User[]        @relation("ChannelMembers")
  messages ChatMessage[]

  @@index([updated_at])
  @@map("chat_channels")
}

model ChatMessage {
  id          String   @id @default(cuid())
  client_id   String?  // Chave de idempotência enviada pelo cliente para evitar duplicações
  content     String
  type        String   @default("text") // "text" | "gif" | "sticker" | "image" | "video" | "audio" | "file" | "ticket"
  channel_id  String
  sender_id   String
  status      String   @default("SENT") // "SENDING" | "SENT" | "DELIVERED" | "READ" | "FAILED"

  is_read     Boolean  @default(false)
  is_pinned   Boolean  @default(false)
  is_edited   Boolean  @default(false)
  reply_to_id String?
  file_name   String?
  file_size   Int?
  metadata    String?

  channel ChatChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  sender  User        @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)

  reactions ChatMessageReaction[]
  receipts  ChatMessageReceipt[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([channel_id, created_at])
  @@index([sender_id])
  @@index([client_id])
  @@map("chat_messages")
}

model ChatMessageReceipt {
  id         String   @id @default(cuid())
  message_id String
  user_id    String
  status     String   @default("DELIVERED") // "DELIVERED" | "READ"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@index([user_id, status])
  @@map("chat_message_receipts")
}

model ChatUserSettings {
  id               String   @id @default(cuid())
  user_id          String   @unique
  sound_enabled    Boolean  @default(true)
  desktop_notify   Boolean  @default(true)
  muted_channels   String?  // JSON array com IDs dos canais silenciados
  recent_emojis    String?  // JSON array com últimos emojis utilizados pelo usuário
  favorite_emojis  String?  // JSON array com emojis favoritados pelo usuário
  emoji_skin_tone  String?  // Modificador Unicode de tom de pele padrão ("", "🏻", "🏼", "🏽", "🏾", "🏿")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("chat_user_settings")
}

model ChatNotificationOutbox {
  id           String    @id @default(cuid())
  message_id   String
  recipient_id String
  sender_id    String
  channel_id   String
  title        String
  body         String
  status       String    @default("PENDING") // PENDING, SENT, FAILED
  attempts     Int       @default(0)
  last_error   String?
  processed_at DateTime?
  created_at   DateTime  @default(now())

  @@index([recipient_id, status])
  @@index([created_at])
  @@map("chat_notification_outbox")
}

model ChatMessageReaction {
  id         String   @id @default(cuid())
  message_id String
  user_id    String
  emoji      String
  created_at DateTime @default(now())

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id, emoji])
  @@index([message_id])
  @@index([user_id])
  @@map("chat_message_reactions")
}

model UserSticker {
  id         String   @id @default(cuid())
  user_id    String
  url        String
  name       String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_stickers")
}

// ---------------------------------------------------------
// FASE 8: GESTÃO E RECUPERAÇÃO DE ACESSO / SENHA
// ---------------------------------------------------------

model PasswordResetRequest {
  id               String    @id @default(cuid())
  protocol         String    @unique
  user_id          String?
  user_name        String
  username         String
  user_email       String
  status           String    @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, CANCELLED
  reset_token      String?   @unique
  token_expires_at DateTime?
  admin_id         String?
  admin_name       String?
  admin_notes      String?
  history          String?   // JSON array com histórico de auditoria
  ip_address       String?
  user_agent       String?

  user             User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  resolved_at      DateTime?

  @@map("password_reset_requests")
}

// ---------------------------------------------------------
// FASE 9: CONFIGURAÇÕES E BRANDING DO SISTEMA
// ---------------------------------------------------------

model SystemSetting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String   // Armazena JSON de configuração ou Data URI base64
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------
// FASE 10: CADASTROS INTELIGENTES E CATÁLOGOS DINÂMICOS
// ---------------------------------------------------------

model Requester {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  job_title       String?
  department_name String?
  company_id      String?
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([name])
  @@index([company_id])
  @@map("requesters")
}

model ItemCatalog {
  id         String   @id @default(cuid())
  name       String
  unit       String?  @default("UN")
  category   String?
  notes      String?
  company_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([name])
  @@map("item_catalog")
}

// ---------------------------------------------------------
// FASE 11: GESTÃO DE ACESSOS A COMPUTADORES (PCs) E COFRE SEGURO
// ---------------------------------------------------------

model PcCollaborator {
  id              String   @id @default(cuid())
  name            String
  employee_code   String?  // Matrícula
  job_title       String?  // Cargo / Função
  department_name String?  // Setor
  location_name   String?  // Unidade
  email           String?  // E-mail corporativo
  phone           String?  // Telefone / Ramal
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  notes           String?  @db.Text
  company_id      String?
  user_id         String?  // Vínculo opcional se tiver conta de sistema no Syngeti
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  assignments     PcUserAssignment[]
  accounts        PcAccount[]
  email_accounts  PcEmailAccount[]

  @@index([name])
  @@index([email])
  @@index([status])
  @@map("pc_collaborators")
}

model PcUserAssignment {
  id              String         @id @default(cuid())
  computer_id     String
  collaborator_id String
  is_primary      Boolean        @default(false)
  start_date      DateTime       @default(now())
  end_date        DateTime?
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED
  assigned_by     String?
  notes           String?        @db.Text
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  collaborator    PcCollaborator @relation(fields: [collaborator_id], references: [id], onDelete: Cascade)
  computer        Computer       @relation(fields: [computer_id], references: [id], onDelete: Cascade)

  @@index([computer_id])
  @@index([collaborator_id])
  @@index([status])
  @@map("pc_user_assignments")
}

model VaultSecret {
  id             String    @id @default(cuid())
  title          String
  encrypted_data String    @db.Text // Ciphertext em Base64
  iv             String    // 12 bytes IV em Hex ou Base64
  auth_tag       String    // 16 bytes GCM auth tag em Hex ou Base64
  key_version    Int       @default(1)
  secret_type    String    @default("PASSWORD") // PASSWORD, PIN, RECOVERY_KEY, LOCAL_ADMIN, API_KEY
  notes          String?   @db.Text
  created_by     String?
  updated_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  accounts       PcAccount[]
  email_accounts PcEmailAccount[]

  @@map("vault_secrets")
}

model PcAccount {
  id                   String          @id @default(cuid())
  computer_id          String
  collaborator_id      String?
  username             String          // ex: "suporte.local", "joao.silva", "admin"
  display_name         String?
  account_type         String          @default("LOCAL_STANDARD") // LOCAL_STANDARD, LOCAL_ADMIN, DOMAIN_USER, DOMAIN_ADMIN, ENTRA_ID, SERVICE_ACCOUNT, OUTRO
  domain               String?         @default("WORKGROUP")
  status               String          @default("ACTIVE") // ACTIVE, INACTIVE, LOCKED, REVIEW_PENDING
  vault_secret_id      String?
  last_password_change DateTime?
  notes                String?         @db.Text
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  computer             Computer        @relation(fields: [computer_id], references: [id], onDelete: Cascade)
  collaborator         PcCollaborator? @relation(fields: [collaborator_id], references: [id], onDelete: SetNull)
  vault_secret         VaultSecret?    @relation(fields: [vault_secret_id], references: [id], onDelete: SetNull)

  @@index([computer_id])
  @@index([collaborator_id])
  @@index([status])
  @@map("pc_accounts")
}

model PcEmailAccount {
  id                String          @id @default(cuid())
  email_address     String
  account_name      String?
  provider          String          @default("M365") // M365, GOOGLE_WORKSPACE, CORPORATE_IMAP, EXCHANGE, OUTRO
  account_type      String          @default("INDIVIDUAL") // INDIVIDUAL, SHARED_MAILBOX, DISTRIBUTION_LIST, SERVICE
  collaborator_id   String?
  computer_id       String?
  status            String          @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED, REVIEW_PENDING
  activation_date   DateTime?
  deactivation_date DateTime?
  auth_method       String          @default("SSO_SAML") // SSO_SAML, OAUTH2, BASIC_AUTH, APPPASSWORD
  mfa_enabled       String          @default("UNKNOWN") // YES, NO, UNKNOWN
  vault_secret_id   String?
  notes             String?         @db.Text
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  collaborator      PcCollaborator? @relation(fields: [collaborator_id], references: [id], onDelete: SetNull)
  computer          Computer?       @relation(fields: [computer_id], references: [id], onDelete: SetNull)
  vault_secret      VaultSecret?    @relation(fields: [vault_secret_id], references: [id], onDelete: SetNull)

  @@index([email_address])
  @@index([collaborator_id])
  @@index([computer_id])
  @@index([status])
  @@map("pc_email_accounts")
}

model PcAccessAuditLog {
  id          String   @id @default(cuid())
  action      String   // VIEW_SECRET, REVEAL_SECRET, COPY_SECRET, CREATE_COMPUTER, UPDATE_COMPUTER, DELETE_COMPUTER, CREATE_ACCOUNT, UPDATE_ACCOUNT, CREATE_EMAIL, UPDATE_EMAIL, ASSIGN_USER, UNASSIGN_USER, EXPORT_REPORT, IMPORT_INVENTORY
  entity_type String   // COMPUTER, ACCOUNT, EMAIL, COLLABORATOR, SECRET
  entity_id   String?
  entity_name String?
  user_id     String?
  user_name   String?
  user_email  String?
  ip_address  String?
  user_agent  String?
  status      String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  details     String?  @db.Text
  created_at  DateTime @default(now())

  @@index([action])
  @@index([entity_type])
  @@index([created_at])
  @@map("pc_access_audit_logs")
}

// ---------------------------------------------------------
// SYNGETI SENTINELA IA: AUDITORIA, MONITORAMENTO & SRE
// ---------------------------------------------------------

model SentinelaTelemetry {
  id          String   @id @default(cuid())
  source      String   // frontend, backend, supabase, vercel, audit
  event_type  String   // error, latency, healthcheck, warning, query
  endpoint    String?
  status_code Int?
  duration_ms Float?
  message     String?
  details     String?  @db.Text
  created_at  DateTime @default(now())

  @@index([source])
  @@index([event_type])
  @@index([created_at])
  @@index([endpoint])
  @@map("sentinela_telemetry")
}

model SentinelaIncident {
  id               String            @id @default(cuid())
  title            String
  description      String            @db.Text
  module           String            // connect-chat, service-desk, database, api, frontend, infrastructure, security
  severity         String            // CRITICAL, HIGH, MEDIUM, LOW
  status           String            @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, IGNORED
  root_cause       String?           @db.Text
  evidence         String?           @db.Text
  recommendation   String?           @db.Text
  first_seen_at    DateTime          @default(now())
  last_seen_at     DateTime          @default(now())
  occurrence_count Int               @default(1)
  resolved_at      DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  actions          SentinelaAction[]

  @@index([status])
  @@index([severity])
  @@index([module])
  @@index([created_at])
  @@map("sentinela_incidents")
}

model SentinelaAction {
  id                String             @id @default(cuid())
  incident_id       String?
  title             String
  description       String             @db.Text
  autonomy_level    Int                @default(1) // 1: Auto Não-Destrutivo, 2: Requer Aprovação, 3: Crítico Restrito
  action_type       String             // DIAGNOSTIC, CACHE_PURGE, RETRY_OUTBOX, OPTIMIZE_INDEX, CODE_PATCH, DB_CLEANUP
  status            String             @default("PROPOSED") // PROPOSED, APPROVED, EXECUTED, REJECTED, FAILED
  target_files      String?            @db.Text
  execution_payload String?            @db.Text
  execution_result  String?            @db.Text
  risk_assessment   String?            @db.Text
  reversion_plan    String?            @db.Text
  created_by        String             @default("SENTINELA_IA")
  approved_by       String?
  approved_at       DateTime?
  executed_at       DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  incident          SentinelaIncident? @relation(fields: [incident_id], references: [id], onDelete: SetNull)

  @@index([incident_id])
  @@index([status])
  @@index([autonomy_level])
  @@index([created_at])
  @@map("sentinela_actions")
}

model SentinelaAuditLog {
  id          String   @id @default(cuid())
  action      String   // RUN_AUDIT, APPROVE_ACTION, REJECT_ACTION, EXECUTE_ACTION, CHAT_QUERY, SYSTEM_ALERT
  user_id     String?
  user_name   String?
  user_email  String?
  details     String   @db.Text
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([action])
  @@index([created_at])
  @@map("sentinela_audit_logs")
}
